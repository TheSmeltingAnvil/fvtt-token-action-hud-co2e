    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@foundryvtt/gulp-plugin": "github:TheSmeltingAnvil/fvtt-gulp-plugin",
