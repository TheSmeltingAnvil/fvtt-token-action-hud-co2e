    "@foundryvtt/utils": "github:TheSmeltingAnvil/fvtt-utils",
    "@foundryvtt/vite-plugin": "github:TheSmeltingAnvil/fvtt-vite-plugins#path:packages/vite-plugin",
    "@tsconfig/recommended": "^1.0.13",
    "@types/jquery": "^3.5.34",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "gulp": "^5.0.1",
    "jiti": "^2.6.1",
    "jquery": "^3.7.1",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "terser": "^5.46.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "7.1.5"
